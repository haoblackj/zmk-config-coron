{
 "exit": 1,
 "results": {
  "pre": "0",
  "flash-base": "0",
  "baseline": "0",
  "t1": "1",
  "t2": "not-run",
  "restore": "0",
  "stop": "trial_1_failed_(rc=1)"
 },
 "must": [
  {
   "glob": "trial1-*.log",
