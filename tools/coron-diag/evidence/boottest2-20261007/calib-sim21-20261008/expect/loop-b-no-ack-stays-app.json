{
 "exit": 1,
 "results": {
  "pre": "0",
  "flash-base": "0",
  "baseline": "0",
  "t1": "1",
  "t2": "not-run",
  "t3": "not-run",
  "restore": "0",
  "stop": "trial_1_failed_(rc=1)"
 },
 "must": [
  {
   "glob": "trial1-*.log",
   "re": "'b' reply: ack line 'ZDIAG bootloader' seen=False, port lost after the send=False"
  },
  {
   "glob": "trial1-*.log",
   "re": "FAIL bootloader of this serial on USB within 30 s \\(state=app\\)"
  },
  {
   "glob": "trial1-*.log",
   "re": "STOPPED before: copy the image to the UF2 drive"
  },
  "trial 1 .*op_sent=True image_written_stage=False",
  "b sent=1, images written=0",
  "LOOP FAILED \\| RESTORE PASS"
 ],
 "must_not": [
  "EVENT",
  "acknowledged",
  {
   "glob": "trial1-*.log",
   "re": "DEVICE-OP cop"
  },
  {
   "glob": "trial2-*.log",
   "re": "."
  }
 ],
 "script": "calib-loop.ps1",
 "args": [
  "-Mode",
  "write",
  "-Dwells",
  "13,17,26"
 ]
}