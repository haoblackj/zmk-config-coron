  {
   "glob": "flash-base-*.log",
   "re": "."
  },
  {
   "glob": "flash-prod-*.log",
   "re": "."
  }
 ],
 "script": "calib-loop.ps1",
 "args": [
  "-Mode",
  "write",
  "-Dwells",
  "13,17,26"
 ]
}