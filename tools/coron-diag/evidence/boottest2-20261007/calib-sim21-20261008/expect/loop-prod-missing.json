{
 "exit": 1,
 "results": {
  "pre": "1",
  "t1": "not-run",
  "t2": "not-run",
  "t3": "not-run",
  "restore": "not-needed",
  "stop": "pre-failed_(rc=1):_nothing_written_to_the_device"
 },
 "must": [
  {
   "glob": "steppre-*.log",
