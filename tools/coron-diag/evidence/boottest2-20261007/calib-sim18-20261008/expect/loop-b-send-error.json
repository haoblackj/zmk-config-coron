{
 "exit": 1,
 "results": {
  "pre": "0",
  "flash-base": "0",
  "baseline": "0",
  "t1": "1",
  "t2": "not-run",
  "t3": "not-run",
  "restore": "0",
  "stop": "trial_1_failed_(rc=1)"
 },
 "must": [
  {
   "glob": "trial1-*.log",
   "re": "\\[calib-io\\] error on COM5 \\(.*inside the write"
  },
  {
   "glob": "trial1-*.log",
   "re": "send classification for 'b': unknown \\(sent stamp=False, NOT-sent stamp=False, timed_out=False, child exit=1\\)"
  },
  {
   "glob": "trial1-*.log",
   "re": "stage op_sent=unknown"
  },
  "trial 1 .*op_sent=unknown",
  "b sent=0, images written=0 .*, not sent \\(child refused\\)=0, send not attempted=0, op sent unknown=1",
  "LOOP FAILED \\| RESTORE PASS"
 ],
 "must_not": [
  {
   "glob": "trial2-*.log",
   "re": "."
  },
  {
   "glob": "trial1-*.log",
   "re": "sent 'b'"
  },
  {
   "glob": "trial1-*.log",
   "re": "NOT sent 'b'"
  }
 ],
 "script": "calib-loop.ps1",
 "args": [
  "-Mode",
  "write",
  "-Dwells",
  "13,17,26"
 ]
}