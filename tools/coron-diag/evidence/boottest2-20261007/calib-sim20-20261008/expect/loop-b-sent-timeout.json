{
 "exit": 1,
 "results": {
  "pre": "0",
  "flash-base": "0",
  "baseline": "0",
  "t1": "1",
  "t2": "not-run",
  "t3": "not-run",
  "restore": "0",
  "stop": "trial_1_failed_(rc=1)"
 },
 "must": [
  {
   "glob": "trial1-*.log",
   "re": "\\[calib-io\\] sent 'b'"
  },
  {
   "glob": "trial1-*.log",
   "re": "timed out; killed with its process tree, termination confirmed; sent stamp PRESENT"
  },
  {
   "glob": "trial1-*.log",
   "re": "stage op_sent=True \\(from the console child.s stamp"
  },
  "trial 1 .*op_sent=True image_written_stage=False",
  "trials started=1, b sent=1, images written=0 \\(boots after a write\\), boots observed=0",
  "LOOP FAILED \\| RESTORE PASS"
 ],
 "must_not": [
  {
   "glob": "trial2-*.log",
   "re": "."
  },
  {
   "glob": "trial1-*.log",
   "re": "DEVICE-OP cop"
  }
 ],
 "script": "calib-loop.ps1",
 "args": [
  "-Mode",
  "write",
  "-Dwells",
  "13,17,26"
 ]
}